---
interface Props {
  title: string;
  url: string;
  category: "AI Tools" | "Developer Resources" | "Design & Icons" | "Marketing Tools" | string;
  logo: string;
  description: string;
}

const { title, url, category, logo, description } = Astro.props;

// Map categories to color badges for visual flair
const categoryStyles: Record<string, string> = {
  "AI Tools": "bg-purple-500/10 text-purple-400 border-purple-500/20",
  "Developer Resources": "bg-blue-500/10 text-blue-400 border-blue-500/20",
  "Design & Icons": "bg-pink-500/10 text-pink-400 border-pink-500/20",
  "Marketing Tools": "bg-amber-500/10 text-amber-400 border-amber-500/20",
};

const badgeClass = categoryStyles[category] || "bg-indigo-500/10 text-indigo-400 border-indigo-500/20";
---

<div class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-slate-700 hover:bg-slate-900/90 hover:shadow-xl hover:shadow-indigo-500/5">
  <div>
    <!-- Card Header: Logo & Tag -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-slate-800 bg-slate-950/80 p-2 shadow-inner group-hover:border-slate-700">
        <img
          src={logo}
          alt={`${title} logo`}
          class="h-10 w-10 object-contain transition-transform duration-300 group-hover:scale-110"
          loading="lazy"
          onerror="this.src='https://via.placeholder.com/64?text=Tool'"
        />
      </div>
      <span class={`inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-medium ${badgeClass}`}>
        {category}
      </span>
    </div>

    <!-- Title & Description -->
    <div class="mt-5">
      <h3 class="text-xl font-bold tracking-tight text-slate-100 group-hover:text-indigo-400 transition-colors">
        <a href={url} target="_blank" rel="noopener noreferrer" class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {title}
        </a>
      </h3>
      <p class="mt-2.5 text-sm leading-relaxed text-slate-400 line-clamp-3">
        {description}
      </p>
    </div>
  </div>

  <!-- Bottom Action Footer -->
  <div class="mt-6 flex items-center justify-between border-t border-slate-800/80 pt-4 text-xs font-semibold text-slate-400 group-hover:text-indigo-400">
    <span class="truncate">{url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </div>
</div>
