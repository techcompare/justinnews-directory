---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');

const categories = ["All", "AI Tools", "Developer Resources", "Design & Icons", "Marketing Tools"];
---

<Layout title="Tech Tools Directory | Modern Tool Catalog">
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 border-b border-slate-800 bg-gradient-to-b from-slate-900/50 to-slate-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-medium text-indigo-400 mb-6">
        <span class="flex h-2 w-2 rounded-full bg-indigo-400 animate-pulse"></span>
        Updated Daily via Decap CMS
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl max-w-3xl mx-auto leading-tight">
        Discover the best tools for your next project.
      </h1>
      <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        A curated directory of software, developer tools, AI platforms, and design assets to supercharge your build workflow.
      </p>

      <!-- Category Filter Pills -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2" id="category-filters">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class={`filter-btn rounded-full px-4 py-2 text-sm font-medium transition-all duration-200 border ${
              cat === 'All'
                ? 'active bg-indigo-600 text-white border-indigo-500 shadow-lg shadow-indigo-600/25'
                : 'bg-slate-900/80 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Decorative background glow -->
    <div class="absolute left-1/2 top-1/2 -z-10 h-[400px] w-[600px] -translate-x-1/2 -translate-y-1/2 opacity-20 blur-3xl bg-indigo-600 pointer-events-none rounded-full"></div>
  </section>

  <!-- Grid Section -->
  <section class="py-12 sm:py-16 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Featured Tools</h2>
        <p class="text-sm text-slate-400 mt-1">Showing <span id="tool-count">{tools.length}</span> tools in library</p>
      </div>
    </div>

    {tools.length === 0 ? (
      <div class="text-center py-20 border border-dashed border-slate-800 rounded-2xl">
        <p class="text-slate-400 text-base">No tools added yet. Use Decap CMS at <a href="/admin/" class="text-indigo-400 underline">/admin</a> to add your first tool.</p>
      </div>
    ) : (
      <div id="tools-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <div data-category={tool.data.category} class="tool-item flex flex-col h-full">
            <ToolCard
              title={tool.data.title}
              url={tool.data.url}
              category={tool.data.category}
              logo={tool.data.logo}
              description={tool.data.description}
            />
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const toolItems = document.querySelectorAll<HTMLElement>('.tool-item');
    const toolCount = document.getElementById('tool-count');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Update active button state
        filterButtons.forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-lg', 'shadow-indigo-600/25', 'active');
          b.classList.add('bg-slate-900/80', 'text-slate-300', 'border-slate-800');
        });

        btn.classList.remove('bg-slate-900/80', 'text-slate-300', 'border-slate-800');
        btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-lg', 'shadow-indigo-600/25', 'active');

        // Filter cards
        let visibleCount = 0;
        toolItems.forEach((item) => {
          const itemCategory = item.getAttribute('data-category');
          if (category === 'All' || itemCategory === category) {
            item.style.display = 'flex';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (toolCount) {
          toolCount.textContent = visibleCount.toString();
        }
      });
    });
  });
</script>
